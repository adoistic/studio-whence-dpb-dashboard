{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sw-dpb-search",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "FIREBASE_PROJECT_ID": "studio-whence-dpb",
    "ADMIN_EMAIL": "adnan@thothica.com",
    "ALLOWED_ORIGINS": "https://dpb.studiowhence.com,https://studio-whence-dpb.web.app,http://localhost:5509"
  },
  // The index lives under search/ in the SAME bucket as every other gated
  // asset. That prefix is deliberately absent from the Cloud Function's
  // presign/read allow-lists, so this Worker is the only way to reach it.
  "r2_buckets": [
    { "binding": "SEARCH_BUCKET", "bucket_name": "studio-whence-dpb" }
  ],
  "kv_namespaces": [
    { "binding": "INDEX_CACHE", "id": "35c7b6a747d0480da1c60cefc2aad6ec" }
  ]
}
