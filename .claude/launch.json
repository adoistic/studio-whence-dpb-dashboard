{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dashboard-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5509
    },
    {
      "name": "hosting-emulator",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "firebase",
        "emulators:start",
        "--only",
        "hosting",
        "--project",
        "studio-whence-dpb"
      ],
      "port": 5000
    }
  ]
}