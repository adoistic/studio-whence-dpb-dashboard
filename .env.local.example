# Copy to .env.local and fill in the real values from the Firebase console
# (Project settings → General → Your apps → SDK setup and configuration).
# .env.local is gitignored; this .example file is committed as a template.
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# The single admin email (gets /admin). Domains @thothica.com + @dpb.in are allow-listed separately.
NEXT_PUBLIC_ADMIN_EMAIL=admin@example.com

# Base URL for the gated dataApi Cloud Function (content/images/research channel).
# In production it is served SAME-ORIGIN via a Firebase Hosting rewrite
# (/api/** → the dataApi function), so the deployed value is just "/api"
# (no CORS, and no need to make the Cloud Run service publicly invocable).
# For local `next dev` against the live function, set this to the function's
# Cloud Run URL instead (e.g. https://dataapi-xxxxx-uc.a.run.app).
NEXT_PUBLIC_DATA_API_URL=/api

# The gated search Worker (Cloudflare). Inlined at BUILD time like every
# NEXT_PUBLIC_* value — a build without it ships a search box that silently
# fails, so it must be set wherever the site is built, not just locally.
NEXT_PUBLIC_SEARCH_API_URL=https://sw-dpb-search.appsadoistic.workers.dev
