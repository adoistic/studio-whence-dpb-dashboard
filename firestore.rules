rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function userEmail() { return request.auth.token.email; }
    function isDomainAllowed() {
      return isSignedIn() && (
        userEmail().matches('.*@thothica[.]com$') ||
        userEmail().matches('.*@dpb[.]in$')
      );
    }
    function isAdmin() {
      return isSignedIn() && userEmail() == 'adnan@thothica.com' && !isSuspended();
    }
    function isSuspended() {
      return isSignedIn() && exists(/databases/$(database)/documents/suspended/$(userEmail()));
    }
    function hasAllowDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/allowlist/$(userEmail()));
    }
    // isAllowlisted EXCLUDES suspended users and includes admin.
    function isAllowlisted() {
      return !isSuspended() && (isAdmin() || isDomainAllowed() || hasAllowDoc());
    }
    function isSubAdmin() {
      return isAdmin() ||
        (isAllowlisted() && hasAllowDoc()
          && get(/databases/$(database)/documents/allowlist/$(userEmail())).data.role == 'sub_admin');
    }

    // ── Work allocation (per-member grants; admin-written) ──
    // A member sees only ALLOCATED works. admin + sub_admins bypass via isSubAdmin().
    // GOTCHA discipline: guard the get() with exists() (hasAlloc), and read every
    // map field with .get(field, default) so an absent list never throws.
    function hasAlloc() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/allocations/$(userEmail()));
    }
    function allocDoc() {
      return get(/databases/$(database)/documents/allocations/$(userEmail())).data;
    }
    // COMIC access uses RAW `figures` (an explicit figure grant unlocks all of
    // that figure's comics; an explicit comic grant unlocks just that comic). A
    // comic grant must NOT cascade to the figure's sibling comics via
    // figures_effective — that set is for RESEARCH access only (figureResearchAllowed).
    function comicAllowed(cid, line, subject) {
      return isSubAdmin() || (hasAlloc() && (
           allocDoc().get('comics', []).hasAny([cid])
        || allocDoc().get('lines', []).hasAny([line])
        || allocDoc().get('figures', []).hasAny([subject]) ));
    }
    function figureResearchAllowed(fline, fslug) {
      return isSubAdmin() || (hasAlloc() && (
           allocDoc().get('lines', []).hasAny([fline])
        || allocDoc().get('figures_effective', []).hasAny([fslug]) ));
    }
    // FEEDBACK gate. A feedback doc carries `comicId` (`{line}__{slug}`); the
    // `line` is DERIVED from comicId (its prefix), never read from the separate
    // `line` field. This matters for LIST queries: a member's per-comic feedback
    // query filters on `comicId` (+ published/hidden) but NOT on `line`, and a
    // `list` rule that reads an UNCONSTRAINED field (resource.data.line) is
    // rejected by Firestore. comicId is in the query filter, so deriving the line
    // from it keeps the rule list-safe. `subject_slug` isn't on the feedback doc,
    // so the figure branch looks it up from the comic doc.
    // Uses RAW `figures` (consistent with comicAllowed): a single-comic grant
    // reaches that comic's feedback via `comics`, a figure grant via `figures`, a
    // line grant via `lines`. A comic grant must NOT cascade to sibling comics'
    // feedback, so this does NOT use figures_effective.
    function feedbackLineOf(cid) {
      return cid.split('__')[0];
    }
    function feedbackAllocAllowed(cid) {
      return isSubAdmin() || (hasAlloc() && (
           allocDoc().get('comics', []).hasAny([cid])
        || allocDoc().get('lines', []).hasAny([feedbackLineOf(cid)])
        || (exists(/databases/$(database)/documents/comics/$(cid))
            && allocDoc().get('figures', []).hasAny([get(/databases/$(database)/documents/comics/$(cid)).data.get('subject_slug','')]))
      ));
    }

    match /allowlist/{email} {
      allow read: if isAllowlisted();
      allow write: if isAdmin();
    }
    match /suspended/{email} {
      // A user may read its OWN suspended doc — the client access gate
      // (useAllowStatus) reads suspended/{email} for every signed-in user to
      // learn whether it is suspended; without this self-read that getDoc is
      // denied, the gate's Promise.all rejects, and a correctly-allowlisted
      // member is wrongly failed-closed to /pending. sub_admins read any.
      allow read: if isSubAdmin() || (isSignedIn() && userEmail() == email);
      allow write: if isAdmin();
    }
    match /access_requests/{email} {
      allow create: if isSignedIn();
      allow read, update: if isAdmin();
    }
    match /access_log/{id} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
    }
    // A member may read ONLY their own allocation doc; admin reads any. Only admin writes.
    match /allocations/{email} {
      allow read:  if isSignedIn() && (userEmail() == email || isAdmin());
      allow write: if isAdmin();
    }

    // ── B2.7 catalog (read-only for allowlisted clients; written only by the
    //    publish Action's Admin SDK, which bypasses rules) ──
    match /meta/{d}      { allow read: if isAllowlisted(); allow write: if false; }
    match /lines/{d}     { allow read: if isAllowlisted(); allow write: if false; }
    // Program tier (Line → Program → Subject): navigational metadata (title/blurb/
    // emblem), readable by any allowlisted member like lines/people. The gated
    // content lives in the comics/dossiers inside, gated by their own rules.
    match /programs/{d}  { allow read: if isAllowlisted(); allow write: if false; }
    // Figure docs DO carry a `line` field (written by the content publish
    // pipeline, tools/publish_to_firestore.py). The doc id `f` IS the
    // subject_slug, so the research gate is driven by `f` via figures_effective;
    // the `lines` branch lights up via resource.data.get('line','') so a member
    // holding only a `lines` grant reaches that line's figure research.
    // A figure is readable when the member's allocation grants its research
    // (figureResearchAllowed) OR the figure is flagged `openResearch:true` — the
    // medicomics model, where each disease is an open-research figure any
    // allowlisted member may read. Specific comics stay allocation-gated.
    match /figures/{f}   {
      allow read: if isAllowlisted()
        && (figureResearchAllowed(resource.data.get('line', ''), f)
            || resource.data.get('openResearch', false) == true);
      allow write: if false;
      match /sources/{s} {
        // Mirror the parent: allow when the member's allocation grants the
        // figure's research OR the parent figure doc is `openResearch:true`
        // (fetched via the existing get() on the parent figure doc).
        allow read: if isAllowlisted()
          && exists(/databases/$(database)/documents/figures/$(f))
          && (figureResearchAllowed(
                get(/databases/$(database)/documents/figures/$(f)).data.get('line', ''), f)
              || get(/databases/$(database)/documents/figures/$(f)).data.get('openResearch', false) == true);
        allow write: if false;
      }
    }
    match /comics/{c} {
      allow read: if isAllowlisted()
        && comicAllowed(c, resource.data.line, resource.data.get('subject_slug', ''));
      allow write: if false;
      // Versions gate on the PARENT comic doc (re-read it; the wildcard `c` is in
      // scope inside this nested match).
      match /versions/{v} {
        allow read: if isAllowlisted()
          && exists(/databases/$(database)/documents/comics/$(c))
          && comicAllowed(c,
               get(/databases/$(database)/documents/comics/$(c)).data.line,
               get(/databases/$(database)/documents/comics/$(c)).data.get('subject_slug', ''));
        allow write: if false;
      }
    }
    // ── AI conversations (captured ChatGPT/Gemini/… transcripts attached to a
    //    line/comic; written only by the capture Admin SDK, which bypasses rules) ──
    // Visibility mirrors the LOCKED decision: line-attached → any allowlisted
    // member; comic-attached → that comic's allocation (via comicAllowed, which
    // already short-circuits for moderators/sub_admins); figure-attached →
    // any allowlisted member when `open:true` (the medicomics disease model),
    // else the member must hold that line (or be a sub_admin). The conversation
    // doc has no subject_slug, so the figure-grant branch of comicAllowed is
    // passed ''; the line + comics + moderator branches still gate access correctly.
    match /aiConversations/{id} {
      allow read: if isAllowlisted() && (
           resource.data.attachTo.kind == 'line'
        || (resource.data.attachTo.kind == 'comic'
            && comicAllowed(
                 resource.data.attachTo.line + '__' + resource.data.attachTo.comicSlug,
                 resource.data.attachTo.line,
                 ''))
        || (resource.data.attachTo.kind == 'figure'
            && (resource.data.attachTo.get('open', false) == true
                || (hasAlloc() && allocDoc().get('lines', []).hasAny([resource.data.attachTo.line]))
                || isSubAdmin()))
        || isSubAdmin()
      );
      allow write: if false;
    }
    match /people/{p}    { allow read: if isAllowlisted(); allow write: if false; }

    // ── Feedback (live source of truth; client-written under these rules) ──
    match /feedback/{id} {
      allow read: if isAllowlisted() && (
        isSubAdmin()
        || (resource.data.published == true && resource.data.hidden == false
            && feedbackAllocAllowed(resource.data.comicId))
      );
      allow create: if isAllowlisted()
        && request.resource.data.authorEmail == userEmail()
        && request.resource.data.hidden == false
        && feedbackAllocAllowed(request.resource.data.comicId)
        && (request.resource.data.parentId == null
              ? request.resource.data.status == 'open' : true)
        // Non-moderators cannot self-publish a root. A reply may be created
        // published ONLY when its parent doc is already published (so a member
        // replying to a published comment stays visible to themselves); a reply
        // to a draft stays draft.
        && (isSubAdmin()
            || request.resource.data.published == false
            || (request.resource.data.parentId != null
                && get(/databases/$(database)/documents/feedback/$(request.resource.data.parentId)).data.published == true));
      allow update: if isSubAdmin()
        || (isAllowlisted()
            && resource.data.authorEmail == userEmail()
            && request.resource.data.authorEmail == resource.data.authorEmail
            && request.resource.data.parentId == resource.data.parentId
            && request.resource.data.comicId == resource.data.comicId
            && request.resource.data.comicVersion == resource.data.comicVersion
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.status == resource.data.status
            && request.resource.data.hidden == resource.data.hidden
            && request.resource.data.published == resource.data.published
            // `.get(...)` (not `.category`) so a doc with no category field —
            // accessing an absent property throws — compares cleanly: an author
            // may not mutate category, but a category-less doc still edits fine.
            && request.resource.data.get('category', null) == resource.data.get('category', null));
      allow delete: if isSubAdmin() || (isAllowlisted() && resource.data.authorEmail == userEmail());
    }

    // ── Idea Drop (moderator-authored idea cards routed to recipients) ──
    match /ideas/{id} {
      allow create: if (isAdmin() || isSubAdmin())
                    && request.resource.data.author == userEmail();

      // The recipients branch reads ONLY `recipients` (no visibility check), so the
      // `recipients array-contains me` inbox list query is accepted by Firestore.
      // Safe: recipients[] is non-empty only for `specific` ideas.
      allow read: if isAdmin()
                  || resource.data.author == userEmail()
                  || (resource.data.visibility == 'all_sub_admins' && isSubAdmin())
                  || (resource.data.visibility == 'all_approved'   && isAllowlisted())
                  || (userEmail() in resource.data.recipients);

      // Admin may change anything. The author may edit ONLY content fields —
      // status/tags/visibility/recipients/author are frozen after create.
      allow update: if isAdmin()
                    || (resource.data.author == userEmail()
                        && request.resource.data.author     == resource.data.author
                        && request.resource.data.status     == resource.data.status
                        && request.resource.data.tags       == resource.data.tags
                        && request.resource.data.visibility == resource.data.visibility
                        && request.resource.data.recipients == resource.data.recipients);

      allow delete: if isAdmin() || resource.data.author == userEmail();

      // ── ChatGPT share captures (subcollection) ──
      // Read mirrors the PARENT idea's read rule via get(); writes are
      // function/sweeper-only (Admin SDK bypasses rules).
      match /captures/{captureId} {
        allow read: if isAdmin()
          || (exists(/databases/$(database)/documents/ideas/$(id)) && (
                 get(/databases/$(database)/documents/ideas/$(id)).data.author == userEmail()
              || (get(/databases/$(database)/documents/ideas/$(id)).data.visibility == 'all_sub_admins' && isSubAdmin())
              || (get(/databases/$(database)/documents/ideas/$(id)).data.visibility == 'all_approved'   && isAllowlisted())
              || (userEmail() in get(/databases/$(database)/documents/ideas/$(id)).data.recipients)));
        allow write: if false;
      }
    }

    match /idea_reads/{email} {
      allow read, write: if isSignedIn() && userEmail() == email;
    }

    match /_internal/{d} { allow read, write: if false; }
  }
}
