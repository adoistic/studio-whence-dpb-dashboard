# Firebase Cloud Functions runtime env for the dataApi function.
# Copy to functions/.env (gitignored) for local emulation, or set on deploy.
# The R2_* values are SECRETS — set them via:
#   firebase functions:secrets:set R2_ENDPOINT R2_ACCESS_KEY_ID R2_SECRET_ACCESS_KEY R2_BUCKET
# (do NOT put real secret values in any committed file).

ADMIN_EMAIL=adnan@thothica.com
# CORS_ORIGINS is wired in a later task (comma-separated allowed origins)
# CORS_ORIGINS=https://studio-whence-dpb.web.app,https://dpb.studiowhence.com,http://localhost:5509
