{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  },
  "hosting": {
    "public": "out",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
      {
        "source": "/api/**",
        "function": { "functionId": "dataApi", "region": "us-central1" }
      },
      { "source": "/*/*", "destination": "/comic.html" },
      { "source": "/*", "destination": "/line.html" }
    ]
  }
}
